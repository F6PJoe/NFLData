# ── Credentials — never commit these ─────────────────────────────────────────
.env
*.json

# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[codz]
*$py.class
*.so

# ── Output CSVs (regenerated on each run) ────────────────────────────────────
*_adp.csv
combined_adp.csv
ff_draft_proj/*.csv
ff_projections/*.csv
ff_defense/*.csv
ff_defense/reddit_post.md

# ── Raw source cache (~90MB of nflverse CSVs, re-fetchable) ──────────────────
ff_projections/cached/
ff_points_against/cached/
ff_idp_points_against/cached/

# ── Long-form reference CSVs (regenerated on each fetch run) ─────────────────
ff_points_against/data/*.csv
ff_idp_points_against/data/*.csv

# Timestamped workbook backups. my_projections.xlsx itself is deliberately
# NOT ignored — it holds hours of hand-entered usage that can't be regenerated,
# so git history is worth having as a safety net.
ff_projections/my_projections.backup-*.xlsx

# ── Probe/debug scripts (one-off helpers, not needed in repo) ─────────────────
probe_*.py
check_*.py

# ── Distribution / packaging ──────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── OS junk ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Tools ────────────────────────────────────────────────────────────────────
.ruff_cache/
.mypy_cache/
ff_defense/nflverse_data/
ff_defense/nflverse_epa_exploration.xlsx
