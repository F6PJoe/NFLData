# Copy to .env and fill in. .env is gitignored -- never commit real values.
#
# FantasyLife (the data pull) is read from ff_draft_proj/.env automatically,
# so nothing to repeat here unless you want to override it.

# WordPress -- only needed by push_to_wordpress.py, which runs when
# component.html changes, NOT on the twice-weekly data refresh.
WP_URL=https://fantasysixpack.net

# The dedicated Editor-role automation account and its Application Password
# (Users -> Profile -> Application Passwords). NOT a login password, and not
# an admin account -- Editor can update posts but can't touch plugins/themes.
WP_USERNAME=f6p-automation
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Numeric post IDs, visible in each post's edit URL (post=NNNNNN).
WP_POST_ID_WEEKLY=
WP_POST_ID_SEASON=

# SFTP -- used by sftp_upload.py to push the 3 weekly data files. From
# SiteGround Site Tools: Site -> SFTP Accounts for a password, or Devs -> SSH
# Keys Manager for a key. Port is often 18765 on SiteGround, not always 22 --
# check what SFTP Accounts actually shows you, don't assume.
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=

# Use EITHER password OR key, not both. If both are set, the key wins.
SFTP_PASSWORD=
SFTP_KEY_PATH=
SFTP_KEY_PASSPHRASE=

# Path to the WordPress install AS SEEN OVER SFTP (contains wp-content) --
# often "public_html" or "www/fantasysixpack.net/public_html", NOT a URL and
# NOT "/". Connect once with any SFTP client (FileZilla, WinSCP) to find it.
SFTP_REMOTE_ROOT=
