# Copy to .env and fill in. .env is gitignored -- never commit real values.
#
# Same SiteGround SFTP account ff_utilization/sftp_upload.py already uses --
# if you have that .env filled in, just copy it here (see that project's
# .env.example for how each value was found).

SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=

# Use EITHER password OR key, not both. If both are set, the key wins.
SFTP_PASSWORD=
SFTP_KEY_PATH=
SFTP_KEY_PASSPHRASE=

# Path to the WordPress install AS SEEN OVER SFTP (contains wp-content) --
# often "public_html" or "www/fantasysixpack.net/public_html", NOT a URL and
# NOT "/". Connect once with any SFTP client (FileZilla, WinSCP) to find it.
SFTP_REMOTE_ROOT=
