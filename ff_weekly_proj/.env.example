# Copy to .env and fill in your credentials — never commit .env

# FTN Fantasy — https://ftnfantasy.com
FTN_EMAIL=your@email.com
FTN_PASSWORD=yourpassword

# CBS Sports (no login needed for public weekly projections)

# Yahoo Fantasy (no login needed for public player pages)

# FantasyData — https://fantasydata.com
FANTASYDATA_EMAIL=your@email.com
FANTASYDATA_PASSWORD=yourpassword

# 4for4 — https://www.4for4.com
FOR4FOR4_EMAIL=your@email.com
FOR4FOR4_PASSWORD=yourpassword

# Draft Sharks — https://www.draftsharks.com
DRAFTSHARKS_EMAIL=your@email.com
DRAFTSHARKS_PASSWORD=yourpassword

# Fantasy Life — https://www.fantasylife.com (Firebase auth)
FANTASYLIFE_EMAIL=your@email.com
FANTASYLIFE_PASSWORD=yourpassword
FANTASYLIFE_FIREBASE_API_KEY=your_firebase_api_key
